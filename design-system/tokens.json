{
  "color-fg": {
    "$type": "color",
    "$description": "Default body text color. Paired with color-bg at 12.6:1 contrast, well above WCAG AA (4.5:1) for normal text.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1216, 0.1608, 0.2157],
      "hex": "#1f2937"
    }
  },
  "color-fg-muted": {
    "$type": "color",
    "$description": "Secondary text: timestamps, helper text, metadata.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.3922, 0.4549, 0.5451],
      "hex": "#64748b"
    }
  },
  "color-bg": {
    "$type": "color",
    "$description": "Default page background.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-bg-subtle": {
    "$type": "color",
    "$description": "Recessed surface background for the app shell (sidebar, table header, page canvas behind cards).",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9725, 0.9804, 0.9882],
      "hex": "#f8fafc"
    }
  },
  "color-primary": {
    "$type": "color",
    "$description": "Brand/action color for primary buttons, links, active nav state, and focus rings.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1137, 0.3059, 0.8471],
      "hex": "#1d4ed8"
    }
  },
  "color-primary-hover": {
    "$type": "color",
    "$description": "Hover/active state for primary-colored elements.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.0863, 0.2471, 0.6863],
      "hex": "#1639af"
    }
  },
  "color-primary-fg": {
    "$type": "color",
    "$description": "Text/icon color placed on top of color-primary.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-border": {
    "$type": "color",
    "$description": "Default border for inputs, cards, dividers.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8196, 0.8392, 0.8627],
      "hex": "#d1d5db"
    }
  },
  "color-success": {
    "$type": "color",
    "$description": "Successful/completed workflow run status.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.0863, 0.5961, 0.3451],
      "hex": "#16a358"
    }
  },
  "color-danger": {
    "$type": "color",
    "$description": "Failed workflow run status and destructive actions.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.7882, 0.1294, 0.1294],
      "hex": "#c92121"
    }
  },
  "color-warning": {
    "$type": "color",
    "$description": "Workflow runs awaiting input or paused.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.7059, 0.4235, 0.0078],
      "hex": "#b46c02"
    }
  },
  "space-1": {
    "$type": "dimension",
    "$description": "Tightest spacing: icon-to-label gaps, chip padding.",
    "$value": { "value": 4, "unit": "px" }
  },
  "space-2": {
    "$type": "dimension",
    "$description": "Default control padding and gaps between related elements.",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$description": "Spacing between distinct fields/rows and card padding.",
    "$value": { "value": 16, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$description": "Section-level spacing between major page regions.",
    "$value": { "value": 24, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "Chips, badges, small controls.",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "Buttons, inputs, default control radius.",
    "$value": { "value": 6, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "Cards and panels.",
    "$value": { "value": 10, "unit": "px" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$description": "System font stack for all UI text; avoids a web-font load for an internal tool.",
    "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  },
  "font-family-mono": {
    "$type": "fontFamily",
    "$description": "Monospace stack for IDs, payloads, and code in workflow step configuration.",
    "$value": "ui-monospace, SFMono-Regular, 'Roboto Mono', Consolas, monospace"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-medium": {
    "$type": "fontWeight",
    "$value": 500
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "font-size-sm": {
    "$type": "dimension",
    "$description": "Table cells, helper text, metadata.",
    "$value": { "value": 12, "unit": "px" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$description": "Default body and control text.",
    "$value": { "value": 14, "unit": "px" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$description": "Page and section headings.",
    "$value": { "value": 20, "unit": "px" }
  },
  "shadow-sm": {
    "$type": "shadow",
    "$description": "Resting elevation for cards.",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.0588, 0.0902, 0.1647],
        "alpha": 0.08,
        "hex": "#0f172a"
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 2, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "shadow-md": {
    "$type": "shadow",
    "$description": "Elevated surfaces: dropdowns, popovers, the step config panel.",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.0588, 0.0902, 0.1647],
        "alpha": 0.12,
        "hex": "#0f172a"
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 4, "unit": "px" },
      "blur": { "value": 12, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-background-hover": {
    "$type": "color",
    "$value": "{color-primary-hover}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "button-secondary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-3}"
  }
}
